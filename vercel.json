{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.js": {
      "maxDuration": 60,
      "supportsCancellation": true,
      "includeFiles": "bin/yt-dlp,node_modules/ffmpeg-static/**"
    }
  }
}